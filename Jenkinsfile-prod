pipeline {
    agent any

    environment { 
        KUBECONFIG_CREDENTIALS_ID = '16b56e7a-f709-4de7-bdc2-2db8eac07561'
    }

    stages {
        stage("对 EKS PROD 环境进行发版") {
            steps {
                withKubeConfig([credentialsId: "${KUBECONFIG_CREDENTIALS_ID}"]) {
                    sh '''
                        helm upgrade --install frontend ./helm-chart/  -f ./values/values-prod.yaml -n scloud-obs-prod
                    '''
                }
            }
        }

        stage("对 PROD 环境发版后进行通知") {
            environment {
                TELEGRAM_BOT_TOKEN = "8274385334:AAElklhX6LoVC-yZ_nYLxwa34MHoq5XuNEU"
                TELEGRAM_CHAT_ID = "-1003004444115"
            }
            steps {
                script {
                    def userName = currentBuild.rawBuild.getCause(hudson.model.Cause$UserIdCause)?.getUserName()
                    def tag = sh(
                        script: "yq '.image.tag' values/values-prod.yaml",
                        returnStdout: true
                    ).trim()
                    
                    // 提取 commit id（假设格式固定为 vX.Y.Z-<commit>-<timestamp>）
                    def commitId = tag.tokenize('-')[1]
                    def alert_message = """
EKS PROD 环境最新发布:
(1)发布内容: 
obs-frontend 更新
commit id: ${commitId}
容器镜像新tag: ${tag}
(2)发布提交人: ${userName}
(3)发布审核人: ${userName}
(4)发布执行人: ${userName}
                    """.stripIndent()
                    // 写入临时文件
                    writeFile file: 'alert.txt', text: alert_message.stripIndent()

                    // 发送消息
                    sh(script: """
                        curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \\
                             -d "chat_id=${TELEGRAM_CHAT_ID}" \\
                             --data-urlencode "text@alert.txt"
                    """)

                }
            }
        }
    }
}
